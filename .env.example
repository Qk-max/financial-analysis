# 金融数据分析系统 — 环境变量配置模板
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
#
# 注意：.env 文件包含敏感信息，已加入 .gitignore，请勿提交到仓库。

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=financial_user
DB_PASSWORD=请在此填写数据库密码
DB_NAME=financial_analysis
APP_LOCAL_ONLY=true

# 仅供 setup_admin.py 创建/重置管理员账户使用；请设置为强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请填写至少8位且含字母和数字的管理员密码

# Streamlit 配置（可选）
# STREAMLIT_SERVER_PORT=8501
